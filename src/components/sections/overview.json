{
  "collectionName": "components_sections_overviews",
  "info": {
    "displayName": "Overview Section",
    "icon": "layout",
    "description": "What you learn, prerequisites, etc."
  },
  "options": {},
  "attributes": {
    "what_you_learn": {
      "type": "component",
      "component": "elements.icon-text-item",
      "repeatable": true
    },
    "what_you_will_learn": {
      "type": "text"
    },
    "what_you_learn_icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "skills": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::skill.skill"
    },
    "course_skills": {
      "type": "text"
    },
    "prerequisites": {
      "type": "component",
      "component": "elements.list-item",
      "repeatable": true
    },
    "prerequisite": {
      "type": "text"
    },
    "why_iqrasity": {
      "type": "component",
      "component": "sections.why-iqrasity",
      "repeatable": false
    },
    "promo_banner": {
      "type": "component",
      "component": "sections.promo-banner",
      "repeatable": false
    },
    "why_choose_this_course": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "who_is_this_course_for": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "start_today": {
      "type": "text"
    },
    "enroll_now": {
      "type": "text"
    },
    "what_next": {
      "type": "text"
    },
    "custom_field_title": {
      "type": "string"
    },
    "custom_field_description": {
      "type": "string"
    }
  }
}
